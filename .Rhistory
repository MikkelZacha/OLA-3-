# ===== OPGAVE 1.1 – MINIMAL KODE =====
library(dplyr)
library(tidyr)
library(stringr)
library(readr)
library(purrr)
library(ggplot2)
# 1) Månedligt bredt -> langt -> kvartal
ft_mdl_lang <- Ftillid_Q3_25 %>%
rename(spoergsmaal = 1) %>%
mutate(across(matches("^\\d{4}M\\d{2}$"),
~ suppressWarnings(parse_number(as.character(.x))))) %>%
pivot_longer(matches("^\\d{4}M\\d{2}$"), names_to = "maaned", values_to = "vaerdi") %>%
# kompakt beregning af tid uden mellemtrin:
mutate(tid = paste0(substr(maaned,1,4),
"K",
(as.integer(substr(maaned,6,7)) - 1) %/% 3 + 1)) %>%
group_by(tid, spoergsmaal) %>%
summarise(vaerdi = mean(vaerdi, na.rm = TRUE), .groups = "drop") %>%
filter(tid >= "2000K1", tid <= "2025K3")
# 2) Bredt kvartalsdatasæt med 12 spørgsmål
FTDI25Q <- ft_mdl_lang %>%
pivot_wider(names_from = spoergsmaal, values_from = vaerdi) %>%
arrange(tid)
# 3) Alle kombinationer
spg <- setdiff(names(FTDI25Q), "tid")
stopifnot(length(spg) == 12)
# Parvise (66)
kombis_par <- combn(spg, 2, simplify = FALSE)
# Alle kombinationer (1..12) = 4095
alle_kombis <- unlist(lapply(1:12, function(k) combn(spg, k, simplify = FALSE)),
recursive = FALSE)
alle_kombis_df <- tibble::tibble(
stoerrelse  = purrr::map_int(alle_kombis, length),
kombi_liste = alle_kombis,
kombi_tekst = purrr::map_chr(alle_kombis, ~ paste(.x, collapse = " | "))
)
alle_kombis_df %>%
count(stoerrelse) %>%                                 # Samme som før
mutate(andelen = n / sum(n)) %>%                      # Beregn andel af totalen
ggplot(aes(x = factor(stoerrelse), y = andelen)) +
geom_col(fill = "#21908CFF") +
geom_text(aes(label = scales::percent(andelen, accuracy = 0.1)),
vjust = -0.3, size = 3.5) +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Andel af kombinationer pr. størrelse (k)",
subtitle = "Procentdel af de 4095 mulige kombinationer",
x = "Antal spørgsmål i kombination (k)",
y = "Andel af alle kombinationer"
) +
theme_minimal(base_size = 13)
View(alle_kombis)
View(FTDI25Q)
View(alle_kombis_df)
library(readr)
Forbrugertillidsindikator2015_2024 <- read_delim("Forbrugertillidsindikator2015-2024.csv",
delim = ";", escape_double = FALSE, trim_ws = TRUE)
View(Forbrugertillidsindikator2015_2024)
library(tidyverse)
fbi <- read.csv("forbrugertillid", sep = ";")
forbrugertillid <- read_delim("forbrugertillid.csv",
delim = ";", escape_double = FALSE, trim_ws = TRUE)
View(forbrugertillid)
# Konverter dato og filtrér perioden
fbi$Tid <- as.Date(fbi$Tid)
fbi <- fbi %>% filter(format(Tid, "%Y") >= 2015)
# Konverter dato og filtrér perioden
forbrugertillid$Tid <- as.Date(fbi$Tid)
# Konverter dato og filtrér perioden
fbi$Tid <- as.Date(forbrugertillidi$Tid)
# Konverter dato og filtrér perioden
fbi$Tid <- as.Date(forbrugertillid$Tid)
forbrugertillid <- read_delim("forbrugertillid.csv",
delim = ";", escape_double = FALSE, trim_ws = TRUE)
# Vend data, så kolonner bliver rækker
fbi <- forbrugertillid %>%
pivot_longer(
cols = -...1,               # alt undtagen første kolonne
names_to = "Tid",           # lav en kolonne med måned-navne
values_to = "Indikator"     # lav en kolonne med værdierne
)
View(fbi)
View(Forbrugertillidsindikator2015_2024)
# Rens og konverter månedskoder til rigtige datoer
fbi <- fbi %>%
mutate(
År = substr(Tid, 1, 4),
Måned = substr(Tid, 6, 7),
Dato = as.Date(paste0(År, "-", Måned, "-01"))
)
# Fjern ubrugelige kolonner
fbi <- fbi %>% select(Dato, Indikator)
# Tjek data
head(fbi)
library(forecast)
install.packages("forecast")
library(forecast)
ts_data <- ts(fbi$Indikator, start = c(2015, 1), frequency = 12)
# Byg modellen automatisk
model <- auto.arima(ts_data)
# Lav forudsigelse for 12 måneder (2025)
forecast_2025 <- forecast(model, h = 12)
# Plot resultatet
plot(forecast_2025, main = "Forbrugertillid – prognose for 2025",
xlab = "År", ylab = "Forbrugertillidsindikator")
mean_2024 <- mean(tail(ts_data, 12))          # Gennemsnit for 2024
mean_2025 <- mean(forecast_2025$mean)         # Forventet gennemsnit for 2025
if (mean_2025 > mean_2024) {
print("Forbrugertilliden forventes at stige → julehandlen sandsynligvis større 🎅")
} else {
print("Forbrugertilliden forventes at falde → julehandlen sandsynligvis lavere 🎁")
}
summary(model)        # viser modelparametre og AIC
checkresiduals(model) # viser residualer og om modellen passer godt
accuracy(model)       # viser fejlmål (MAE, RMSE osv.)
