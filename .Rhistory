library(tidyr)                               # pivot_longer/pivot_wider
library(stringr)                             # String-hjælpere (str_sub)
library(purrr)                               # map / funktionel programmering
library(readr)                               # parse_number til robust numerik
library(ggplot2)                             # Plot (valgfrit)
ft_mdl_lang <- Ftillid_Q3_25 %>%                               # Tag månedligt, bredt datasæt
rename(spoergsmaal = 1) %>%                                  # Giv kolonne 1 et navn (“spoergsmaal”)
mutate(across(matches("^\\d{4}M\\d{2}$"),                    # Find alle måneds-kolonner via regex
~ suppressWarnings(parse_number(as.character(.x))))) %>%
pivot_longer(cols = matches("^\\d{4}M\\d{2}$"),              # Smelt bredt -> langt pr. måned
names_to = "maaned", values_to = "vaerdi") %>%
mutate(aar = as.integer(str_sub(maaned, 1, 4)),              # Træk år ud af “YYYYMmm”
m   = as.integer(str_sub(maaned, 6, 7)),              # Træk måned (mm)
k   = (m - 1) %/% 3 + 1,                              # Konverter måned -> kvartal 1..4
tid = paste0(aar, "K", k)) %>%                        # Byg “YYYYKq”-etiket
group_by(tid, spoergsmaal) %>%                               # Gruppér pr. kvartal og spørgsmål
summarise(vaerdi = mean(vaerdi, na.rm = TRUE), .groups="drop") %>% # Gennemsnit over 3 mdr.
filter(tid >= "2000K1", tid <= "2025K3")                     # Afgræns opgavens tidsinterval
ft_mdl_lang <- Ftillid_Q3_25 %>%                               # Tag månedligt, bredt datasæt
rename(spoergsmaal = 1) %>%                                  # Giv kolonne 1 et navn (“spoergsmaal”)
mutate(across(matches("^\\d{4}M\\d{2}$"),                    # Find alle måneds-kolonner via regex
~ suppressWarnings(parse_number(as.character(.x))))) %>%
pivot_longer(cols = matches("^\\d{4}M\\d{2}$"),              # Smelt bredt -> langt pr. måned
names_to = "maaned", values_to = "vaerdi") %>%
mutate(aar = as.integer(str_sub(maaned, 1, 4)),              # Træk år ud af “YYYYMmm”
m   = as.integer(str_sub(maaned, 6, 7)),              # Træk måned (mm)
k   = (m - 1) %/% 3 + 1,                              # Konverter måned -> kvartal 1..4
tid = paste0(aar, "K", k)) %>%                        # Byg “YYYYKq”-etiket
group_by(tid, spoergsmaal) %>%                               # Gruppér pr. kvartal og spørgsmål
summarise(vaerdi = mean(vaerdi, na.rm = TRUE), .groups="drop") %>% # Gennemsnit over 3 mdr.
filter(tid >= "2000K1", tid <= "2025K3")                     # Afgræns opgavens tidsinterval
library(readr)
Ftillid_Q3_25 <- read_delim("Ftillid Q3 25.csv",
delim = ";", escape_double = FALSE, trim_ws = TRUE)
View(Ftillid_Q3_25)
library(readr)
Forbrug_25 <- read_delim("Forbrug 25.csv",
delim = ";", escape_double = FALSE, trim_ws = TRUE)
View(Forbrug_25)
ft_mdl_lang <- Ftillid_Q3_25 %>%                               # Tag månedligt, bredt datasæt
rename(spoergsmaal = 1) %>%                                  # Giv kolonne 1 et navn (“spoergsmaal”)
mutate(across(matches("^\\d{4}M\\d{2}$"),                    # Find alle måneds-kolonner via regex
~ suppressWarnings(parse_number(as.character(.x))))) %>%
pivot_longer(cols = matches("^\\d{4}M\\d{2}$"),              # Smelt bredt -> langt pr. måned
names_to = "maaned", values_to = "vaerdi") %>%
mutate(aar = as.integer(str_sub(maaned, 1, 4)),              # Træk år ud af “YYYYMmm”
m   = as.integer(str_sub(maaned, 6, 7)),              # Træk måned (mm)
k   = (m - 1) %/% 3 + 1,                              # Konverter måned -> kvartal 1..4
tid = paste0(aar, "K", k)) %>%                        # Byg “YYYYKq”-etiket
group_by(tid, spoergsmaal) %>%                               # Gruppér pr. kvartal og spørgsmål
summarise(vaerdi = mean(vaerdi, na.rm = TRUE), .groups="drop") %>% # Gennemsnit over 3 mdr.
filter(tid >= "2000K1", tid <= "2025K3")                     # Afgræns opgavens tidsinterval
# ---------- 2) Forbrug (kvartaler) -> langt ----------
forb_kvart_lang <- Forbrug_25 %>%                              # Tag kvartalsvist, bredt datasæt
rename(indikator = 1) %>%                                    # Navngiv kolonne 1 til “indikator”
mutate(across(matches("^\\d{4}K[1-4]$"),                     # Find alle kvartals-kolonner
~ suppressWarnings(parse_number(as.character(.x))))) %>%
pivot_longer(cols = matches("^\\d{4}K[1-4]$"),               # Smelt bredt -> langt pr. kvartal
names_to = "tid", values_to = "vaerdi") %>%
filter(tid >= "2000K1", tid <= "2025K3")                     # Afgræns samme interval
# ---------- 3) FTDI25Q: kvartalsvist bredt sæt med 12 spørgsmål ----------
FTDI25Q <- ft_mdl_lang %>%                                     # Tag den lange tillidstabel
distinct(tid, spoergsmaal, vaerdi) %>%                       # Sikker fjernelse af dubletter
pivot_wider(names_from = spoergsmaal, values_from = vaerdi) %>% # Gør bred: 1 kolonne pr. spørgsmål
arrange(tid)                                                 # Sortér kronologisk
spg_pretty <- setdiff(names(FTDI25Q), "tid")                   # Gem pæne spørgsmålstitler (til visning)
if (length(spg_pretty) != 12) {                                # Tjek at der er præcis 12
warning("Forventede 12 spørgsmål, fandt ", length(spg_pretty),
". Navne: ", paste(spg_pretty, collapse = " | "))
}
# ---------- 4) Sikker kopi til modeller (formel-venlige navne) ----------
name_map <- tibble(                                            # Byg map mellem pæne og “sikre” navne
pretty = c("tid", spg_pretty),
safe   = make.names(c("tid", spg_pretty), unique = TRUE)     # make.names laver syntaktisk gyldige navne
)
FTDI25Q_safe <- FTDI25Q                                        # Kopiér datasæt
names(FTDI25Q_safe) <- name_map$safe                           # Sæt sikre navne på kolonner
to_safe   <- function(v) name_map$safe[match(v, name_map$pretty)]   # Helper: pretty -> safe
to_pretty <- function(v) name_map$pretty[match(v, name_map$safe)]   # Helper: safe   -> pretty
# ---------- 5) Kombinationslister ----------
kombis_par_pretty <- combn(spg_pretty, 2, simplify = FALSE)    # Parvise kombinationer (66 stk.)
alle_kombis_pretty <- unlist(                                  # Alle kombinationer (1..12) = 4095
lapply(1:length(spg_pretty), function(k) combn(spg_pretty, k, simplify = FALSE)),
recursive = FALSE
)
alle_kombis_df <- tibble(                                      # Pæn tabel over alle kombinationer
stoerrelse  = map_int(alle_kombis_pretty, length),           # Antal spørgsmål i kombinationen
kombi_liste = alle_kombis_pretty,                            # Selve kombinationen (liste)
kombi_tekst = map_chr(alle_kombis_pretty, ~ paste(.x, collapse = " | ")) # Læsbart navn
)
# ---------- 6) Korrelationer for parvise kombinationer ----------
kombis_par_safe <- lapply(kombis_par_pretty, to_safe)          # Map pæne -> sikre navne til beregning
alle_par_long <- map_dfr(kombis_par_safe, function(p_safe) {   # Loop over alle par
FTDI25Q_safe %>%
select(tid = !!name_map$safe[1],                            # Vælg tidskolonne
x   = all_of(p_safe[1]),                             # Spørgsmål A
y   = all_of(p_safe[2])) %>%                         # Spørgsmål B
mutate(spm1 = to_pretty(p_safe[1]),                         # Gem pænt navn A
spm2 = to_pretty(p_safe[2]),                         # Gem pænt navn B
.before = x)
})
korrelationer_par <- alle_par_long %>%                         # Beregn korrelation pr. par
group_by(spm1, spm2) %>%
summarise(n = sum(!is.na(x) & !is.na(y)),                     # Antal gyldige observationer
korrelation = cor(x, y, use = "pairwise.complete.obs"), # Pearson r
.groups = "drop") %>%
arrange(desc(korrelation))                                    # Sortér fra højest r
forbrug_P31 <- forb_kvart_lang %>%                             # Tag forbrugstabellen (lang)
filter(grepl("P\\.31|privat\\s*forbrug", indikator, ignore.case = TRUE)) %>% # Find P.31-rækker
group_by(tid) %>%                                            # Summér pr. kvartal (hvis flere rækker)
summarise(forbrug = sum(vaerdi, na.rm = TRUE), .groups = "drop")
if (nrow(forbrug_P31) == 0) {                                  # Fallback hvis P.31 ikke findes i teksten
message("Fandt ikke 'P.31' i indikator-teksten. Bruger første indikator som proxy.")
forbrug_P31 <- forb_kvart_lang %>% group_by(tid) %>% slice(1) %>%
summarise(forbrug = sum(vaerdi, na.rm = TRUE), .groups = "drop")
}
View(forbrug_P31)
data_model_safe <- FTDI25Q_safe %>%                            # Byg model-datasæt (sikre navne)
left_join(forbrug_P31, by = c(tid = "tid")) %>%              # Join på kvartal
drop_na(forbrug)                                             # Drop kvartaler uden forbrug
resp_safe <- "forbrug"                                         # Responsnavn i model-datasættet
alle_kombis_safe <- lapply(alle_kombis_pretty, to_safe)        # Map alle kombinationer -> sikre navne
r2_resultater <- map_dfr(alle_kombis_safe, function(vars_safe) { # Kør en lm pr. kombination
vars_safe <- vars_safe[!is.na(vars_safe)]                    # Rens NA (hvis nogen)
if (length(vars_safe) == 0) return(NULL)                     # Skip tomme kombinationer
formel <- reformulate(termlabels = vars_safe, response = resp_safe) # Byg formel sikkert
mod <- lm(formel, data = data_model_safe)                    # Kør lineær regression
s   <- summary(mod)                                          # Træk modelresumé
tibble(
stoerrelse  = length(vars_safe),                           # Antal forklarende variabler
kombi_tekst = paste(to_pretty(vars_safe), collapse = " | "), # Pæn visning af kombination
R2          = unname(s$r.squared),                         # R²
adjR2       = unname(s$adj.r.squared)                      # Justeret R² (sammenligneligt på tværs af k)
)
})
top10_r2 <- r2_resultater %>%                                  # De 10 bedste kombinationer (adjR²)
arrange(desc(adjR2)) %>%
slice_head(n = 10)
r2_resultater %>%
group_by(stoerrelse) %>%
summarise(mean_adjR2 = mean(adjR2, na.rm = TRUE)) %>%
ggplot(aes(x = stoerrelse, y = mean_adjR2)) +
geom_line(linewidth = 1.2, color = "#2C7BB6") +
geom_point(size = 3, color = "#2C7BB6") +
geom_text(aes(label = round(mean_adjR2, 3)), vjust = -0.8, size = 3.5) +
scale_x_continuous(breaks = 1:12) +
labs(
title = "Gennemsnitlig justeret R² pr. kombinationsstørrelse",
subtitle = "Viser hvor meget modellen forbedres, når du tilføjer flere spørgsmål",
x = "Antal spørgsmål i kombination (k)",
y = "Gennemsnitlig justeret R²"
) +
theme_minimal(base_size = 13)
cat("\n— FTDI25Q (første 3 rækker) —\n"); print(head(FTDI25Q, 3)) # Se de første 3 kvartaler
cat("\nParvise kombinationer:", length(kombis_par_pretty), "\n")  # Burde være 66
cat("Alle kombinationer:", nrow(alle_kombis_df), "\n")            # Burde være 4095
cat("\n— Top 10 adj.R² (bedste forklaring på forbrug) —\n"); print(top10_r2) # Se top-10
View(alle_kombis_df)
View(alle_kombis_pretty)
View(alle_par_long)
