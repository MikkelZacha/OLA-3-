# Vi starter med at indlæse de vigtigste R-pakker
library(dplyr)    # bruges til at filtrere, gruppere og ændre data
library(tidyr)    # bruges til at lave data "langt" eller "bredt"
library(purrr)    # bruges til at lave loops på en smart måde (map)
library(readr)    # bruges til at omdanne tekst til tal
library(ggplot2)  # bruges til at lave grafer
library(stringr)  # bruges til at arbejde med tekst (str_sub, regex)
ft <- Ftillid_Q3_25 %>%                     # Vi starter med datasættet Ftillid_Q3_25
rename(spoergsmaal = 1) %>%               # Giv første kolonne navnet “spoergsmaal”
pivot_longer(                             # Laver data om fra bredt format (mange kolonner)
cols = matches("^\\d{4}M\\d{2}$"),      # Finder alle kolonner med mønsteret “ÅÅÅÅMmm”
names_to = "maaned",                    # Gem kolonnenavnet som “maaned”
values_to = "vaerdi"                    # Gem tallene som “vaerdi”
) %>%
mutate(                                   # Tilføj ekstra kolonner
vaerdi = as.numeric(vaerdi),            # Sørg for at tallene er numeriske
aar = as.integer(substr(maaned, 1, 4)), # Træk år ud (de første 4 tegn)
m = as.integer(substr(maaned, 6, 7)),   # Træk måned ud (de sidste 2 tegn)
k = (m - 1) %/% 3 + 1,                  # Regn ud hvilket kvartal måneden hører til (1-4)
tid = paste0(aar, "K", k)               # Lav en ny kolonne med tekst som “2010K2”
) %>%
group_by(tid, spoergsmaal) %>%            # Gruppér data efter kvartal og spørgsmål
summarise(vaerdi = mean(vaerdi, na.rm = TRUE), .groups = "drop")
